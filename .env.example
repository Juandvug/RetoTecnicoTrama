# Variables de entorno (docs/ARCHITECTURE.md §11). Copiá este archivo a
# .env.local y completalo. Nunca se commitean valores reales, y ninguna
# variable lleva el prefijo NEXT_PUBLIC_: todas son solo del servidor.

# Proveedor LLM
# Solo en .env.local y en Vercel; nunca en el repo ni en la documentación.
OPENAI_API_KEY=
# openai | fake (fake está prohibido en producción). Para trabajar sin key:
# LLM_PROVIDER=fake y FAKE_LLM_SCENARIO=ejemplo
LLM_PROVIDER=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=

# Acceso (obligatorias en todos los entornos)
# 8 caracteres o más; se comparte por el canal de entrega, nunca en el repo
ACCESS_CODE=
# 32 bytes o más: openssl rand -base64 48
SESSION_SECRET=

# Rate limiting (Upstash Redis; obligatorio en producción, en local usa memoria)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Por defecto: 50 turnos por sesión cada 24 h, 60 por IP por hora y 1000 por día en total
RATE_LIMIT_SESSION=
RATE_LIMIT_IP=
RATE_LIMIT_GLOBAL=

# Umbrales de fase (ADR-0007; por defecto 3 y 3)
MAX_MENSAJES_DELIMITAR=
MAX_TURNOS_SIN_VERSION=

# Escenario del LLM simulado (tests/fixtures/scenarios/<nombre>.json)
FAKE_LLM_SCENARIO=
