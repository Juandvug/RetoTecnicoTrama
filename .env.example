# Variables de entorno (docs/ARCHITECTURE.md §11). Copiá este archivo a
# .env.local y completalo. Nunca se commitean valores reales.

# Proveedor LLM
OPENAI_API_KEY=
# openai | fake (fake está prohibido en producción)
LLM_PROVIDER=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=

# Acceso
ACCESS_CODE=
# 32 bytes o más: openssl rand -base64 48
SESSION_SECRET=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SESSION=
RATE_LIMIT_IP=
RATE_LIMIT_GLOBAL=

# Umbrales de fase (ADR-0007; por defecto 3 y 3)
MAX_MENSAJES_DELIMITAR=
MAX_TURNOS_SIN_VERSION=

# Solo para el e2e
FAKE_LLM_SCENARIO=
